{
  "name": "playce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:check": "bash scripts/security-check.sh . && bash scripts/check-authz-todos.sh",
    "test": "node --test tests/*.test.mjs",
    "test:firestore": "RUN_FIRESTORE_TESTS=1 node --env-file=.env.local --conditions=react-server --import ./tests/firestore/register.mjs --test --test-concurrency=1 --test-timeout=300000 tests/firestore/*.test.mjs"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "@grpc/grpc-js": "1.14.7"
  }
}
