# コピーして .env.local を作る。.env.local はコミットしない。
# --- サーバー専用(秘密に準ずる。NEXT_PUBLIC_ を付けない) ---
# 管理者として許可する Google アカウント(カンマ区切り)。未設定なら全員拒否。
ADMIN_EMAILS=
GCLOUD_PROJECT=demo-playce
# 開発時のみ(エミュレータ)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# --- ブラウザに公開される値(秘密を入れない) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-playce
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_AUTH_EMULATOR_HOST=127.0.0.1:9099

# 申込フォームの署名用(本番は必須。長いランダム文字列)
FORM_SECRET=
# X-Forwarded-For のうち信頼するプロキシ段数(ホスティング環境で確認して設定)
TRUSTED_PROXY_HOPS=1
